#!/usr/bin/env bash
# Blocks commits that add likely-sensitive content. Enable once with:
#   git config core.hooksPath .githooks
# Add organisation-specific strings (names, domains, internal URLs, one regex per line)
# to .sensitive-patterns -- that file is git-ignored on purpose, so the list itself never leaks.

added=$(git diff --cached --no-color -U0 --diff-filter=AM | grep -E '^\+[^+]' | sed 's/^+//' || true)

fail=0
check() { # $1 = description, $2 = regex
  # placeholder domains (example.org/.com/.net) are allowed
  hits=$(printf '%s\n' "$added" | grep -Ein -- "$2" | grep -Eiv '@example\.(org|com|net)' | head -5 || true)
  if [ -n "$hits" ]; then
    echo "Blocked: $1"; echo "$hits"; echo; fail=1
  fi
}

if [ -n "$added" ]; then
  check "email address"                  '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
  check "personal/absolute Windows path" '[A-Za-z]:[\\/]+Users[\\/]+[^\\/ "]+'
  check "possible credential"            '(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']+["'"'"']'
  # a real grant reference number (GRN), for example 25-ECW-FER-10-ABC-XYZ (the templates use 00-ECW-FER-00-XXX-AAA)
  hits=$(printf '%s\n' "$added" | grep -En '[0-9]{2}-ECW-[A-Z]{3}-[0-9]{2}-[A-Z]{3}-[A-Z]{3}' | grep -Ev '00-ECW-FER-00-XXX-AAA' | head -5 || true)
  if [ -n "$hits" ]; then echo "Blocked: real grant reference number (GRN)"; echo "$hits"; echo; fail=1; fi

  if [ -f .sensitive-patterns ]; then
    while IFS= read -r pat; do
      [ -z "$pat" ] && continue
      case "$pat" in \#*) continue;; esac
      check "matches local sensitive pattern" "$pat"
    done < .sensitive-patterns
  fi
fi

# Data and settings files must never be staged. Allowed: the templates and the list of analysis codes.
staged=$(git diff --cached --name-only --diff-filter=AM)
bad_files=$(printf '%s\n' "$staged" | grep -Ei '\.(xlsx|xls|csv|rds|rdata)$|^data/(input|cleaned|output)/|^config\.yml$' \
            | grep -Ev '^templates/|^data/input/analysis_codes/|\.gitkeep$' || true)
if [ -n "$bad_files" ]; then echo "Blocked: data or settings files staged:"; echo "$bad_files"; echo; fail=1; fi

[ $fail -ne 0 ] && { echo "Commit aborted. Fix the above (or use --no-verify if you are certain)."; exit 1; }
exit 0

.sensitive-patterns

# all data stays local / on Drive: never commit data or outputs
data/cleaned/*
!data/cleaned/.gitkeep
data/output/*
!data/output/.gitkeep
**/*.xlsx
**/*.csv
**/*.txt

# reference tables that are safe to version
!data/input/analysis_codes/analysis_codes.xlsx
!templates/*.xlsx
!templates/*.csv
